{
  "name": "telegram-number-panel",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "start": "npm run start --workspace server",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:seed": "tsx server/src/utils/seed.ts",
    "test": "npm run test --workspace server"
  },
  "devDependencies": { "concurrently": "^9.0.1", "typescript": "^5.6.3", "tsx": "^4.19.2" }
}